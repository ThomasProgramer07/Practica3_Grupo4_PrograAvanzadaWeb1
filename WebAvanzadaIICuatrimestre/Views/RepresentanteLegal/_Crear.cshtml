@model WebAvanzadaIICuatrimestre.BLL.Dtos.RepresentanteLegalDto

<div class="modal fade" id="modalCrearRepresentanteLegal" tabindex="-1" aria-labelledby="labelModalCrearRepresentanteLegal" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">

            <div class="modal-header text-white" style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);">
                <h5 class="modal-title fw-semibold" id="labelModalCrearRepresentanteLegal">
                    <i class="bi bi-person-plus-fill me-2"></i>Nuevo Representante Legal
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <form id="formCrearRepresentanteLegal" asp-action="CreateRepresentanteLegal" asp-controller="RepresentanteLegal" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="col-md-6">
                        <label asp-for="Identificacion" class="form-label fw-medium">
                            <i class="bi bi-card-text text-primary me-1"></i>Identificación
                        </label>
                        <input asp-for="Identificacion" class="form-control" placeholder="Ej: 1-0001-0001" />
                        <span asp-validation-for="Identificacion" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Sexo" class="form-label fw-medium">
                            <i class="bi bi-gender-ambiguous text-primary me-1"></i>Sexo
                        </label>
                        <select asp-for="Sexo">
                            <option value="1">Hombre</option>
                            <option value="2">Mujer</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Nombre" class="form-label fw-medium">
                            <i class="bi bi-person text-primary me-1"></i>Nombre
                        </label>
                        <input asp-for="Nombre" class="form-control" placeholder="Nombre" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Edad" class="form-label fw-medium">
                            <i class="bi bi-calendar text-primary me-1"></i>Edad
                        </label>
                        <input asp-for="Edad" type="number" min="0" class="form-control" placeholder="0" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Apellido1" class="form-label fw-medium">
                            <i class="bi bi-person-badge text-primary me-1"></i>Apellido 1
                        </label>
                        <input asp-for="Apellido1" class="form-control" placeholder="Primer apellido" />
                        <span asp-validation-for="Apellido1" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Apellido2" class="form-label fw-medium">
                            <i class="bi bi-person-badge text-primary me-1"></i>Apellido 2
                        </label>
                        <input asp-for="Apellido2" class="form-control" placeholder="Segundo apellido" />
                        <span asp-validation-for="Apellido2" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-medium">
                            <i class="bi bi-telephone text-primary me-1"></i>Teléfonos
                        </label>
                        <div id="telefonosCrear"></div>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="btnAgregarTelefonoCrear">
                            <i class="bi bi-plus-lg"></i> Agregar teléfono
                        </button>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-medium">
                            <i class="bi bi-envelope text-primary me-1"></i>Correos electrónicos
                        </label>
                        <div id="correosCrear"></div>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="btnAgregarCorreoCrear">
                            <i class="bi bi-plus-lg"></i> Agregar correo
                        </button>
                    </div>

                </form>
            </div>

            <div class="modal-footer border-top px-4 py-3">
                <button type="button" class="btn btn-light border" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Cerrar
                </button>
                <button type="button" class="btn btn-primary" id="btnGuardarRepresentanteLegal">
                    <i class="bi bi-floppy me-1"></i>Guardar
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model List<WebAvanzadaIICuatrimestre.BLL.Dtos.ResultadoDto>

@{
    ViewData["Title"] = "Resultados de la Votación";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0 text-center">Resultados de la Votación</h3>
                </div>
                <div class="card-body">
                    @if (Model != null && Model.Any())
                    {
                        <table class="table table-striped table-hover align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>Sigla</th>
                                    <th>Partido Político</th>
                                    <th class="text-end">Total de Votos</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td><span class="badge bg-secondary fs-6">@item.Sigla</span></td>
                                        <td class="fw-bold">@item.Nombre</td>
                                        <td class="text-end">
                                            <span class="badge bg-success fs-6 px-3">@item.CantidadVotos</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted text-center my-3">No hay resultados de votación disponibles en este momento.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>